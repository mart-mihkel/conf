#!/usr/bin/env bash

set -uo pipefail

log()   { printf "\033[1;34minfo    \033[0m %s\n" "$*" >&2; }
error() { printf "\033[1;31merror   \033[0m %s\n" "$*" >&2; }
die()   { error "$*"; exit 1; }

server_up() {
    herdr status server 2>/dev/null | grep -q "^status: running"
}

start_server() {
    log "starting herdr server"
    (cd ~ && setsid herdr server </dev/null >/dev/null 2>&1 &)

    for _ in $(seq 100); do
        server_up && return 0
        sleep 0.1
    done

    die "herdr server did not come up"
}

ws_id() {
    herdr workspace list 2>/dev/null | \
        jq -r --arg label "$1" \
        'first(.result.workspaces[] | select(.label == $label).workspace_id) // empty' \
        2>/dev/null
}

default_ws_id() {
    herdr workspace list 2>/dev/null | \
        jq -r 'first(.result.workspaces[]
               | select(.label == "~" and .pane_count == 1).workspace_id) // empty' \
        2>/dev/null
}

pane_ready() {
    herdr pane process-info --pane "$1" 2>/dev/null | \
        jq -e '.result.process_info | .shell_pid == .foreground_process_group_id' \
        >/dev/null 2>&1
}

run_in_pane() {
    for _ in $(seq 30); do
        pane_ready "$1" && break
        sleep 0.1
    done

    herdr pane run "$1" "$2" >/dev/null || error "could not start $2 in $1"
}

new_tab() {
    local wsid=$1 label=$2 cmd=${3:-} pane

    pane=$(
        herdr tab create --workspace "$wsid" --cwd "$PROJECT" --label "$label" --no-focus | \
        jq -r '.result.root_pane.pane_id // empty' 2>/dev/null
    )

    [[ -n $pane ]] || { error "could not create $label tab"; return 0; }
    [[ -n $cmd ]] && run_in_pane "$pane" "$cmd"

    return 0
}

create_workspace() {
    local json wsid tab pane

    json=$(herdr workspace create --cwd "$PROJECT" --label "$WS" --focus)
    wsid=$(jq -r '.result.workspace.workspace_id // empty' <<<"$json" 2>/dev/null)
    tab=$(jq -r '.result.tab.tab_id // empty' <<<"$json" 2>/dev/null)
    pane=$(jq -r '.result.root_pane.pane_id // empty' <<<"$json" 2>/dev/null)

    [[ -n $wsid ]] || return 1

    herdr tab rename "$tab" vi >/dev/null
    run_in_pane "$pane" nvim
    new_tab "$wsid" sh
    new_tab "$wsid" pi pi
    herdr tab focus "$tab" >/dev/null

    echo "$wsid"
}

PROJECT=$(
    fdfind -d 1 -t d . ~/git | \
    fzf --gutter " " --pointer " " --delimiter / --with-nth "{-2}"
)

[[ -n $PROJECT ]] || die "no project selected"

WS=$(basename "$PROJECT" | tr . _)

STRAY=
if ! server_up; then
    start_server
    STRAY=$(default_ws_id)
fi

WSID=$(ws_id "$WS")

if [[ -z $WSID ]]; then
    log "creating workspace $WS"
    WSID=$(create_workspace) || die "could not create workspace $WS"
fi

if [[ -n $STRAY && $STRAY != "$WSID" ]]; then
    log "closing default workspace $STRAY"
    herdr workspace close "$STRAY" >/dev/null
fi

log "focusing workspace $WSID"
herdr workspace focus "$WSID" >/dev/null

if [[ -z ${HERDR_ENV:-} ]]; then
    log "attaching herdr"
    exec herdr
fi
