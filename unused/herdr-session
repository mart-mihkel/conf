#!/usr/bin/env bash

log()   { printf "\033[1;34minfo    \033[0m %s\n" "$*"; }
error() { printf "\033[1;31merror   \033[0m %s\n" "$*"; }

PROJECT=$(
    fd -d 1 -t d . ~/git | \
    fzf --gutter " " --pointer " " --delimiter / --with-nth "{5}"
)

if [[ -z ${PROJECT:-} ]]; then
    error "no project selected"
    exit 1
fi

SESSION=$(basename "$PROJECT" | tr . _)

if ! herdr status server 2>/dev/null | grep -q "^status: running"; then
    log "starting herdr server"
    (cd ~ && nohup herdr server </dev/null >/dev/null 2>&1 &)
    for _ in $(seq 50); do
        herdr status server 2>/dev/null | grep -q "^status: running" && break
        sleep 0.1
    done

    if ! herdr status server 2>/dev/null | grep -q "^status: running"; then
        error "herdr server did not come up"
        exit 1
    fi
fi

WSID=$(
    herdr workspace list 2>/dev/null | \
    jq -r --arg label "$SESSION" \
        'first(.result.workspaces[] | select(.label == $label).workspace_id) // empty' \
        2>/dev/null
)

if [[ -z $WSID ]]; then
    log "starting herdr workspace for $SESSION"
    WSID=$(
        herdr workspace create --cwd "$PROJECT" --label "$SESSION" 2>/dev/null | \
        jq -r '.result.workspace.workspace_id // empty' 2>/dev/null
    )
fi

if [[ -z $WSID ]]; then
    error "could not start workspace for $SESSION"
    exit 1
fi

if [[ -n ${HERDR_ENV:-} ]]; then
    log "switching to workspace $SESSION"
    herdr workspace focus "$WSID" >/dev/null
else
    log "attaching to workspace $SESSION"
    herdr workspace focus "$WSID" >/dev/null
    exec herdr
fi
