{
  "spacing": 20,
  "margin-bottom": -50,
  "reload_style_on_change": true,
  "modules-left": [
    "hyprland/workspaces"
  ],
  "modules-right": [
    "network",
    "bluetooth",
    "wireplumber",
    "backlight",
    "battery",
    "clock"
  ],
  "hyprland/workspaces": {
    "format": "{icon}",
    "format-icons": {
      "1": "one",
      "2": "two",
      "3": "three",
      "4": "four",
      "5": "five",
      "6": "six",
      "7": "seven",
      "8": "eight",
      "9": "nine",
      "10": "ten"
    }
  },
  "clock": {
    "format": "󰃰 {:%H:%M}"
  },
  "network": {
    "on-click": "foot -e wlctl",
    "format-wifi": "{icon}{signalStrength}%",
    "format-ethernet": "󰌗 eth",
    "format-disconnected": "󰤮 off",
    "format-icons": [
      "󰤯 ",
      "󰤟 ",
      "󰤢 ",
      "󰤥 ",
      "󰤨 "
    ]
  },
  "bluetooth": {
    "on-click": "foot -e bluetui",
    "format-on": "󰂯 on",
    "format-connected": "󰂱 con",
    "format-connected-battery": "󰂱 {device_battery_percentage}%"
  },
  "wireplumber": {
    "on-click": "foot -e pulsemixer",
    "format": "󰕾 {volume}%",
    "format-muted": "󰖁 off"
  },
  "backlight": {
    "format": "{icon}{percent}%",
    "format-icons": [
      "󰃞 ",
      "󰃟 ",
      "󰃠 "
    ]
  },
  "battery": {
    "on-click": "foot -e btop",
    "format": "{icon}{capacity}%",
    "format-icons": {
      "default": [
        "󰂎 ",
        "󰁺 ",
        "󰁻 ",
        "󰁼 ",
        "󰁽 ",
        "󰁾 ",
        "󰁿 ",
        "󰂀 ",
        "󰂁 ",
        "󰂂 ",
        "󰁹 "
      ],
      "charging": [
        "󰢟 ",
        "󰢜 ",
        "󰂆 ",
        "󰂇 ",
        "󰂈 ",
        "󰢝 ",
        "󰂉 ",
        "󰢞 ",
        "󰂊 ",
        "󰂋 ",
        "󰂅 "
      ]
    },
    "states": {
      "warning": 20,
      "critical": 10
    },
    "events": {
      "on-discharging-warning": "notify-send -u normal 'Power' 'Battery at 20%'",
      "on-discharging-critical": "notify-send -u critical 'Power' 'Battery at 10%'"
    }
  }
}
