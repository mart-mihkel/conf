#!/usr/bin/env sh

# FIXME: broken on tahoe (asmvik/yabai#2821)
yabai -m signal --add event=dock_did_restart action="sudo yabai --load-sa"
sudo yabai --load-sa || true

yabai -m signal --add event=space_changed action="sketchybar --trigger space_change"
yabai -m signal --add event=display_changed action="sketchybar --trigger space_change"

yabai -m rule --add app="^Raycast$" manage=off

yabai -m config layout bsp

# Reserve room for sketchybar (height=28 in sketchybarrc) on every display.
# Without this, windows tile underneath the bar on non-main displays where
# macOS does not already reserve the menu-bar / notch area.
yabai -m config external_bar all:28:0

yabai -m config window_gap     10
yabai -m config top_padding    20
yabai -m config left_padding   20
yabai -m config right_padding  20
yabai -m config bottom_padding 20

yabai -m config window_placement second_child
yabai -m config window_origin_display focused

yabai -m config mouse_modifier alt
yabai -m config mouse_action1  move
yabai -m config mouse_action2  resize

yabai -m config window_shadow off

yabai -m config mouse_follows_focus on
yabai -m config focus_follows_mouse autofocus
